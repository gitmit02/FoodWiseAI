# Port the Express server runs on
PORT=5000

# OPTIONAL: AI API key for generating reasons/recommendations using an LLM.
# If left empty, FoodWise AI automatically uses its built-in rule-based
# analysis instead, so the app still works fully for a demo without any key.
#
# This project calls the Anthropic Messages API format. If you have an
# Anthropic API key, paste it below.
AI_API_KEY=

# Optional: override the AI endpoint/model if needed
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-3-5-haiku-20241022
